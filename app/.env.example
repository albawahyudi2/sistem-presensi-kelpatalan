# Salin ke .env.local dan isi. Jangan commit .env.local.

# Neon: connection string pooled (host berakhiran -pooler) untuk runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DBNAME?sslmode=require"
# Neon: connection string direct (tanpa -pooler) untuk migrasi Prisma
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Auth.js: buat dengan `npx auth secret` atau `openssl rand -base64 32`
AUTH_SECRET=""

# Akun admin pertama (dipakai oleh seed; wajib diganti saat login pertama)
ADMIN_USERNAME="admin"
ADMIN_INITIAL_PASSWORD=""

# Set "false" untuk melewati pegawai dummy saat seed
SEED_DUMMY="true"

# Cloudinary (dipakai mulai change 02)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Rahasia untuk cron retensi foto (Vercel mengirimnya sebagai Authorization: Bearer ...)
CRON_SECRET=""
